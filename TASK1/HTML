
<!DOCTYPE html>
<html>
<head>
    <title>Naughty Bites Kitchen</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <h2>Naughty Bites Kitchen</h2>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#products">Menu</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main>

        <!-- Hero Section -->
        <section class="hero" id="home">
            <h1>Welcome to Naughty Bites Kitchen</h1>

            <p>Fresh Homemade Food, Made with Love</p>

            <a href="#products">
                <button>Shop Now</button>
            </a>
        </section>

        <!-- About Us Section -->
        <section class="about" id="about">

            <div class="about-card">

                <img src="meals.jpg" alt="Fresh homemade South Indian meals">

                <h2>About Us</h2>

                <p>
                    Naughty Bites Kitchen serves fresh, homemade food
                    prepared with love and care. We make delicious meals
                    for families and individuals who enjoy home-style cooking.
                </p>

                <div class="social-links">
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">WhatsApp</a>
                </div>

            </div>

        </section>

        <!-- Products Section -->
        <section class="products" id="products">

            <h2>Our Delicious Menu</h2>

            <div class="product-list">

                <!-- Product 1 -->
                <div class="product-card">

                    <img src="meals.jpg" alt="South Indian meals">

                    <h3>South Indian Meals</h3>

                    <p>₹120</p>

                    <button>Buy Now</button>

                </div>

                <!-- Product 2 -->
                <div class="product-card">

                    <img src="chapathi.jpg" alt="Chapati with curry">

                    <h3>Chapati & Curry</h3>

                    <p>₹80</p>

                    <button>Buy Now</button>

                </div>

                <!-- Product 3 -->
                <div class="product-card">

                    <img src="variety-rice.jpg" alt="Variety rice">

                    <h3>Variety Rice</h3>

                    <p>₹70</p>

                    <button>Buy Now</button>

                </div>

            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer class="footer" id="contact">

        <p>© 2026 Naughty Bites Kitchen. All rights reserved.</p>

        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </div>

    </footer>

</body>
</html>
