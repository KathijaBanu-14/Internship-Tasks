// Get HTML Elements

const userImage = document.getElementById("user-img");

const userName = document.getElementById("user-name");

const userEmail = document.getElementById("user-email");

const userPhone = document.getElementById("user-phone");

const userLocation = document.getElementById("user-location");

const newUserButton = document.getElementById("new-user-btn");


// Get Random User

async function getUser() {

    userName.textContent = "Loading...";
    newUserButton.disabled = true;

    try {

        const response = await fetch("https://randomuser.me/api/");

        const data = await response.json();

        const user = data.results[0];


        // Display User Photo

        userImage.src = user.picture.large;


        // Display Full Name

        userName.textContent =
            user.name.first + " " + user.name.last;


        // Display Email

        userEmail.textContent = "Email: " + user.email;


        // Display Phone

        userPhone.textContent = "Phone: " + user.phone;


        // Display Location

        userLocation.textContent =
            "Location: " + user.location.city +
            ", " + user.location.country;

    }

    catch (error) {

        userName.textContent = "Unable to load user";

        userEmail.textContent = "Please try again.";

        console.log(error);

    }

    newUserButton.disabled = false;

}


// Button Click

newUserButton.addEventListener("click", getUser);


// Load First User

getUser();
