/* Basic Reset */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


/* Body */

body {
    font-family: Arial, sans-serif;
    background-color: lightblue;

    display: flex;
    justify-content: center;
    align-items: center;

    min-height: 100vh;
}


/* User Card */

.user-card {
    background-color: white;
    width: 400px;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 0 10px gray;
    text-align: center;
}


/* User Image */

#user-img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid lightblue;
    margin-bottom: 20px;
}


/* User Name */

#user-name {
    color: darkblue;
    margin-bottom: 20px;
}


/* User Details */

.user-card p {
    margin: 12px 0;
    font-size: 16px;
    color: gray;
}


/* Button */

#new-user-btn {
    background-color: darkblue;
    color: white;
    padding: 12px 25px;
    border: none;
    border-radius: 8px;
    margin-top: 15px;
    cursor: pointer;
    font-size: 16px;
}


/* Button Hover */

#new-user-btn:hover {
    background-color: blue;
}


/* Responsive */

@media (max-width: 450px) {

    .user-card {
        width: 90%;
    }

}
